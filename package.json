{
  "name": "burnsville-mern-app",
  "version": "1.0.0",
  "description": "burnsville-mern-app",
  "main": "server.js",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node backend/server",
    "server": "nodemon backend/server",
    "client": "npm run dev --prefix frontend",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "npm ci --prefix frontend --include=dev && npm run build --prefix frontend",
    "data:bootstrap": "node backend/bootstrap",
    "data:import": "node backend/seeder",
    "data:destroy": "node backend/seeder -d",
    "catalogue:replace": "node scripts/product-catalogue-replacement.mjs",
    "qa:product-assets": "node qa/product-assets.mjs",
    "qa:product-cards": "node qa/product-card-assets.mjs",
    "qa:catalogue": "node qa/catalogue-readiness.mjs",
    "test:catalogue-validator": "node qa/catalogue-readiness.test.mjs",
    "qa:setup-current-db": "node qa/setup-current-db.mjs",
    "qa:product-replacement": "node qa/product-replacement-isolated.mjs",
    "qa:product-catalogue-api": "node qa/product-catalogue-api.mjs"
  },
  "author": "David Miller",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "2.4.3",
    "colors": "1.4.0",
    "dotenv": "8.2.0",
    "express": "4.22.2",
    "express-async-handler": "1.1.4",
    "jsonwebtoken": "9.0.3",
    "mongoose": "8.24.4",
    "morgan": "1.11.0",
    "multer": "2.3.0"
  },
  "devDependencies": {
    "concurrently": "5.3.0",
    "nodemon": "2.0.5"
  }
}
